  type: thesis
  title: "5G-GTP Agentic IDS: An Agentic Intrusion Detection Architecture for the 5G User Plane"
  authors:
    - family-names: "Hernández"
      given-names: "Justo"
      affiliation: "Universidad Politécnica de Cartagena (UPCT)"
  institution:
    name: "Universidad Politécnica de Cartagena (UPCT)"
  thesis-type: "Master's Thesis (TFM)"
  year: 2026
references:
  - type: dataset
    title: "5G-NIDD: A Comprehensive Network Intrusion Detection Dataset Generated over 5G Wireless Network"
    url: "https://ieee-dataport.org/10203"
    notes: >
      The underlying dataset used by this project. Not redistributed in
      this repository; see data/dataset_instructions.md for how to obtain
      it under the original authors' own terms. Cite the dataset
      separately using the author list and citation format given on its
