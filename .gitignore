# Data (large binaries, never committed)
data/raw/**/*.pcapng
data/raw/**/*.csv
data/processed/**/*.csv
data/features/**
!data/features/.gitkeep
.DS_Store
**/.DS_Store

# Reference PDFs (large binaries, not source; kept locally). Exception:
# the thesis document and defense slides ARE meant to be published, once
# added, under docs/ -- see docs/README.md.
*.pdf
!docs/*.pdf

# Outputs
outputs/figures/**
outputs/reports/**
outputs/logs/**
outputs/checkpoints/**
outputs/cache/**
!outputs/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# Poetry / packaging
dist/
build/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
